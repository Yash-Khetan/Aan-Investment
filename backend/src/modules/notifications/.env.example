# ---------------------------------------------------------------------------
# Notifications module — provider credentials (example).
#
# PLACEHOLDERS ONLY. Never put real values in this file: it IS committed.
# Copy these keys into `backend/.env`, which is the only file the runtime loads
# and is git-ignored.
#
# Every variable below is optional at boot. A deployment that never sends a
# given channel may leave that channel blank; the module raises
# ProviderConfigError at send time if the channel it needs is unconfigured.
# ---------------------------------------------------------------------------

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=
SMTP_PORT=
# Implicit TLS. Port 465 is TLS-on-connect; 587 uses STARTTLS and must be false.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Twilio (SMS + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for SMS.
TWILIO_PHONE_NUMBER=
# E.164 sender for WhatsApp (the "whatsapp:" prefix is added for you).
TWILIO_WHATSAPP_NUMBER=
