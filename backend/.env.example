# ---------------------------------------------------------------------------
# Environment configuration (example)
#
# PLACEHOLDERS ONLY. Copy this file to `backend/.env` and fill in real values.
# `.env` is git-ignored and must never be committed; this file IS committed, so
# never paste a real secret here.
#
# `backend/.env` is the ONLY file the runtime loads (see src/config/env.ts).
# Every variable below is read there and nowhere else — no module reads
# process.env directly.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# REQUIRED. Full PostgreSQL connection string (Supabase transaction pooler).
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres

# --- Supabase project -----------------------------------------------------
# Reserved for the storage / hosted-auth integration. Not read by the runtime
# today; kept here so a deployment provisions them alongside DATABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Authentication -------------------------------------------------------
# Session-token validity in days. Default: 7
# Authentication is session-based: the opaque token issued at login is the
# credential clients send as a Bearer token, and it is stored server-side as a
# session (only its SHA-256 hash is persisted). There is no access-token JWT and
# therefore no signing secret.
REFRESH_TOKEN_TTL_DAYS=7

# Base URL of the front-end password-reset page. The forgot-password flow
# appends `?token=…` and emails the resulting link.
APP_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# --- Seed: bootstrap admin account ----------------------------------------
# Read ONLY by `npm run db:seed`, never by the running server. The seed creates
# exactly one ADMIN user with these credentials (idempotent: an existing admin is
# left untouched, and its password is never reset by a re-run).
#
# The defaults below are published in the README, so they are PUBLIC. Override
# BOTH before seeding anything that is not a throwaway local database. The
# password must satisfy the normal policy: 8-128 chars, >=1 letter, >=1 number.
SEED_ADMIN_EMAIL=tonymony5678@gmail.com
SEED_ADMIN_PASSWORD=<change-me-before-any-real-deployment>

# --- CORS -----------------------------------------------------------------
# Comma-separated allowed origins. REQUIRED in production (boot fails without it).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Logging --------------------------------------------------------------
# Pino level override (debug|info|warn|error). Defaults: debug in dev, info in prod.
# LOG_LEVEL=debug

# --- Notifications: Email (Nodemailer / SMTP) -----------------------------
# Optional at boot. Required only to actually deliver email (e.g. the
# password-reset link). Also mirrored in src/modules/notifications/.env.example.
SMTP_HOST=
SMTP_PORT=
# Implicit TLS. Port 465 is TLS-on-connect; 587 uses STARTTLS and must be false.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Notifications: Twilio (SMS + WhatsApp) -------------------------------
# Optional at boot. Required only to deliver SMS / WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender for SMS.
TWILIO_PHONE_NUMBER=
# E.164 sender for WhatsApp (the "whatsapp:" prefix is added for you).
TWILIO_WHATSAPP_NUMBER=
