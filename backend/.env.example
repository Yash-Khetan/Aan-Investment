# ---------------------------------------------------------------------------
# Environment configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Database — full PostgreSQL connection string (Supabase transaction pooler)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres

# Supabase project (used for storage / auth integration)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Authentication
# JWT_ACCESS_SECRET must be a long random string (>= 32 chars).
# Generate one with: openssl rand -hex 48
JWT_ACCESS_SECRET=<random-secret-at-least-32-chars>
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS — comma-separated allowed origins (REQUIRED in production)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Logging — pino level override (debug|info|warn|error)
# LOG_LEVEL=debug
