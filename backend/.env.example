# ==============================================================
#  Backend environment configuration (TEMPLATE — safe to commit)
#  Copy this file to `.env` and fill in real values locally.
#  NEVER put real secrets in this file.
# ==============================================================

# ── Runtime ──
# NODE_ENV: development | test | production   (default: development)
NODE_ENV=development
# PORT the HTTP server listens on             (default: 3000)
PORT=3000

# ── Database (Supabase Postgres) ──
# Shared project database. Copy the REAL value from your feat/auth
# branch .env (same DB for all modules). Do NOT commit the real string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Auth / Supabase (feat/auth module only; NOT required to boot the Loan module) ──
# Uncomment and set when the Auth module is merged in. Copy real values from
# your feat/auth .env. Do NOT commit real keys.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# SUPABASE_SECRET_KEY=<secret-key>
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# JWT_SECRET=
