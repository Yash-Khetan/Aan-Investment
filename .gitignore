# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.output/

# Environment variables
# Ignore every .env variant, then re-admit the committed placeholder template.
# The negation MUST come last: `.env.*` would otherwise swallow `.env.example`.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
.claude/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.settings/
*.iml

# Testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Temporary / debug scratch files
# Throwaway scripts written to poke at the database or an endpoint during
# verification. They are never part of the codebase and must never be committed.
*.tmp
*.tmp.*
*.temp
probe.*
scratch.*
debug.*

# Misc
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/

# Personal punch-list tracker (not product code)
punchlist/

# Drizzle
drizzle/meta/

# Supabase
.supabase/

# Package lock (keep only one)
# Uncomment the ones you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
